rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: pharmacies
    // Fields: name, neighborhood, lat, lng, status, phone, address, rating
    //
    // Collection: medications
    // Fields: name, molecule, standardPrice, category, description
    //
    // Collection: stocks
    // Fields: pharmacyId, medicationId, quantity, price
    //
    // Collection: users
    // Fields: name, phone, email, role
    //
    // Collection: orders
    // Fields: userId, pharmacyId, items, total, status, deliveryType, createdAt
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          (request.auth.token.email == "barakamichaelklg@gmail.com") ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isValidPharmacy(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.neighborhood in ['Ibanda', 'Kadutu', 'Bagira'] &&
             data.lat is number && data.lng is number &&
             data.status in ['certified', 'pending'] &&
             data.phone is string && data.phone.size() > 5;
    }

    function isValidMedication(data) {
      return data.name is string && data.name.size() > 0 &&
             data.molecule is string &&
             data.standardPrice is number && data.standardPrice >= 0 &&
             data.category is string;
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'paid', 'delivered', 'cancelled'] &&
             data.deliveryType in ['pickup', 'delivery'] &&
             (data.createdAt is timestamp || data.createdAt == request.time);
    }

    // Rules
    
    match /pharmacies/{pharmacyId} {
      allow read: if true; // Publicly readable for map and search
      allow write: if isAdmin();
    }

    match /medications/{medId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stocks/{stockId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pharmacist');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role == 'user';
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role; // Cannot change role
    }

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && isValidOrder(request.resource.data);
      allow update: if isAdmin() || 
                    (isOwner(resource.data.userId) && 
                     ((request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||
                      (request.resource.data.status == 'paid' && resource.data.status == 'pending')));
      allow delete: if isAdmin() || (isOwner(resource.data.userId) && resource.data.status == 'pending');
    }
  }
}
